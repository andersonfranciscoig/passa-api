NODE_ENV=development
PORT=3333

# PostgreSQL (npm run db:up)
DATABASE_URL=postgresql://passa:passa@localhost:5434/passa

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Tokens de acesso (JWT) — use um segredo longo e aleatório em produção
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio-passa
JWT_ACCESS_TTL_SECONDS=28800

# Única conta criada pelo seed
SEED_ADMIN_EMAIL=admin@passa.ao
SEED_ADMIN_PASSWORD=admin2026

# Email transaccional (Brevo). Em testes locais sem envio: EMAIL_PROVIDER=console
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@passa.ao
EMAIL_FROM_NAME=PASSA
EMAIL_REPLY_TO=noreply@passa.ao
EMAIL_API_KEY=

# Fotografias (UploadThing — as mesmas credenciais do portal). "memory" só em testes.
STORAGE_PROVIDER=uploadthing
UPLOADTHING_TOKEN=
UPLOADTHING_ACL=public-read
UPLOAD_MAX_BYTES=5242880
